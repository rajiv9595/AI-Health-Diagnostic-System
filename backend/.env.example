# Supabase Configuration
# Replace this with your Supabase Transaction Pooler URL or Direct Connection String
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres

# Flask Security (Change these in production!)
SECRET_KEY=your-secret-key-change-this
JWT_SECRET_KEY=your-jwt-secret-key-change-this

# Environment (development or production)
FLASK_ENV=development
